# ============================================
# ERP Lite Backend - Variáveis de Ambiente
# ============================================

# Ambiente (development, staging, production)
NODE_ENV=development

# Porta do servidor
PORT=3001

# ============================================
# BANCO DE DADOS
# ============================================
# PostgreSQL connection string
DATABASE_URL="postgresql://erp_user:erp_password@localhost:5432/erp_lite?schema=public"

# ============================================
# AUTENTICAÇÃO
# ============================================
# JWT Secret (mínimo 32 caracteres em produção)
JWT_SECRET="change-this-secret-in-production-minimum-32-chars-long"

# Token expiration
JWT_EXPIRES_IN="1h"
REFRESH_TOKEN_EXPIRES_IN="7d"

# ============================================
# FRONTEND
# ============================================
# URL do frontend (para CORS)
FRONTEND_URL="http://localhost:5173"

# ============================================
# LOGS
# ============================================
# Log level (error, warn, info, debug)
LOG_LEVEL="info"

# ============================================
# RATE LIMITING
# ============================================
# Máximo de requisições por janela
RATE_LIMIT_MAX=1000
# Janela de tempo em minutos
RATE_LIMIT_WINDOW=15

# ============================================
# CERTIFICADO DIGITAL (FISCAL)
# ============================================
# Caminho para o certificado A1
CERTIFICATE_PATH="./certificates/certificate.pfx"
# Senha do certificado
CERTIFICATE_PASSWORD=""

# ============================================
# SEFAZ (FISCAL)
# ============================================
# Ambiente SEFAZ (producao, homologacao)
SEFAZ_ENVIRONMENT="homologacao"
# UF do emitente
SEFAZ_UF="MG"

# ============================================
# EMAIL (SMTP)
# ============================================
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="seu-email@gmail.com"
SMTP_PASSWORD="sua-senha"
SMTP_FROM="ERP Lite <noreply@erplite.com.br>"

# ============================================
# STORAGE (S3/MinIO)
# ============================================
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_BUCKET="erp-lite"
S3_REGION="us-east-1"

# ============================================
# MONITORAMENTO
# ============================================
# Sentry DSN (para captura de erros)
SENTRY_DSN=""
# Datadog API Key
DATADOG_API_KEY=""
