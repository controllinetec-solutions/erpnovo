# ============================================
# ERP Lite Backend Python - Variáveis de Ambiente
# ============================================

# Ambiente (development, staging, production)
APP_ENV=development

# Nome da aplicação
APP_NAME="ERP Lite"

# Versão da API
API_V1_STR=/api/v1

# ============================================
# BANCO DE DADOS
# ============================================
# PostgreSQL connection string
DATABASE_URL=postgresql://erp_user:erp_password@localhost:5432/erp_lite

# ============================================
# SEGURANÇA
# ============================================
# JWT Secret (mínimo 32 caracteres em produção)
# IMPORTANTE: Mude isso em produção!
SECRET_KEY=erp-lite-secret-key-change-in-production-minimum-32-chars-long-2026

# Algoritmo JWT
ALGORITHM=HS256

# Tempo de expiração do access token (minutos)
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Tempo de expiração do refresh token (dias)
REFRESH_TOKEN_EXPIRE_DAYS=7

# ============================================
# CORS
# ============================================
# URL do frontend (para CORS)
FRONTEND_URL=http://localhost:5173

# URLs adicionais permitidas (separadas por vírgula)
# CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ============================================
# LOGS
# ============================================
# Nível de log (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# ============================================
# RATE LIMITING
# ============================================
# Máximo de requisições por minuto
RATE_LIMIT_PER_MINUTE=100
