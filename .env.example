# URL do backend API
# Desenvolvimento local:
VITE_API_URL=http://localhost:3001/api/v1

# Produção:
# VITE_API_URL=https://api.erplite.com.br/v1

# Usar dados mock (true = dados locais, false = backend real)
VITE_USE_MOCK=true

# Ambiente (development, staging, production)
VITE_APP_ENV=development
